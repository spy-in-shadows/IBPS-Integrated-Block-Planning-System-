# Leave VITE_API_BASE_URL unset in almost all cases. The app then calls `/api`,
# which the Vite dev server proxies to http://127.0.0.1:8000 (vite.config.ts)
# and Vercel rewrites to the hosted backend (vercel.json).
# Set it only when the frontend is served from a host that does not proxy /api,
# using the backend's public URL including its /api prefix.
# Do not put secrets in VITE_ variables: they are included in the browser bundle.
# VITE_API_BASE_URL=https://your-api.example.com/api
